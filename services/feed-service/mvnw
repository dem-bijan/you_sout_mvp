#!/bin/sh
# Maven Wrapper script — downloads Maven if not present
# Adapted from the standard Maven Wrapper

set -e

MAVEN_WRAPPER_PROPERTIES="${0%/*}/.mvn/wrapper/maven-wrapper.properties"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
    MAVEN_URL=$(grep 'distributionUrl' "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2- | tr -d '\r')
fi

MAVEN_URL="${MAVEN_URL:-https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/3.9.9/apache-maven-3.9.9-bin.zip}"

MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-3.9.9"

if [ ! -f "$MAVEN_HOME/bin/mvn" ]; then
    echo "Downloading Maven..."
    mkdir -p "$MAVEN_HOME"
    TMPFILE=$(mktemp /tmp/maven-XXXXXX.zip)
    if command -v curl > /dev/null 2>&1; then
        curl -fsSL -o "$TMPFILE" "$MAVEN_URL"
    elif command -v wget > /dev/null 2>&1; then
        wget -q -O "$TMPFILE" "$MAVEN_URL"
    else
        echo "Error: curl or wget required" >&2
        exit 1
    fi
    unzip -qo "$TMPFILE" -d "$MAVEN_HOME/.."
    rm -f "$TMPFILE"
fi

exec "$MAVEN_HOME/bin/mvn" "$@"
